; OpenBone runtime for Godot 4.4+ (GDExtension, built against godot-cpp 4.4). Adds the OpenBoneSprite node.
; Prebuilt for Windows x86_64, macOS (universal: Apple Silicon + Intel), Linux x86_64 / arm64 and Android arm64.
; https://github.com/UXCentury/open-bone

[configuration]

entry_symbol = "openbone_library_init"
compatibility_minimum = "4.4"
reloadable = false

[libraries]

windows.debug.x86_64 = "res://addons/openbone/bin/openbone.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/openbone/bin/openbone.windows.template_release.x86_64.dll"
macos.debug = "res://addons/openbone/bin/libopenbone.macos.template_debug.universal.dylib"
macos.release = "res://addons/openbone/bin/libopenbone.macos.template_release.universal.dylib"
linux.debug.x86_64 = "res://addons/openbone/bin/libopenbone.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/openbone/bin/libopenbone.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://addons/openbone/bin/libopenbone.linux.template_debug.arm64.so"
linux.release.arm64 = "res://addons/openbone/bin/libopenbone.linux.template_release.arm64.so"
android.debug.arm64 = "res://addons/openbone/bin/libopenbone.android.template_debug.arm64.so"
android.release.arm64 = "res://addons/openbone/bin/libopenbone.android.template_release.arm64.so"

[icons]

OpenBoneSprite = "res://addons/openbone/icons/OpenBoneSprite.svg"
