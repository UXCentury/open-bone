  "scripts": [
    {
      "id": "scr_ci9yoat",
      "name": "scroll",
      "code": "// Parallax scrolling: layers slide at their own speed while \"walk\" is on, wrapping every tile width.\nconst layers = [{\"bone\":\"bg-far\",\"x\":700,\"y\":290,\"w\":2300,\"speed\":14},{\"bone\":\"bg-mid\",\"x\":700,\"y\":100,\"w\":2300,\"speed\":55},{\"bone\":\"bg-ground\",\"x\":700,\"y\":-21,\"w\":2300,\"speed\":184}];\nconst off = layers.map(() => 0);\nlet v = 0;\nfunction onUpdate(dt) {\n  const target = Number(ob.input(\"walk\")) || 0;\n  v += (target - v) * Math.min(1, dt * 5);\n  for (let i = 0; i < layers.length; i++) {\n    const l = layers[i];\n    off[i] = (off[i] - l.speed * v * dt) % l.w;\n    ob.setBone(l.bone, { x: l.x + off[i], y: l.y });\n  }\n}"
    }
  ],
