{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "editor",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@openbone/editor",
        "dev"
      ],
      "port": 5180,
      "autoPort": true
    },
    {
      "name": "editor-5181",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@openbone/editor",
        "exec",
        "vite",
        "--port",
        "5181",
        "--strictPort"
      ],
      "port": 5181
    },
    {
      "name": "engines",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@openbone/examples",
        "engines"
      ],
      "port": 5190
    },
    {
      "name": "editor-art",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@openbone/editor",
        "exec",
        "vite",
        "--host",
        "127.0.0.1",
        "--port",
        "5187",
        "--strictPort"
      ],
      "port": 5187,
      "url": "http://127.0.0.1:5187"
    },
    {
      "name": "editor-pen",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@openbone/editor",
        "exec",
        "vite",
        "--host",
        "127.0.0.1",
        "--port",
        "5188",
        "--strictPort"
      ],
      "port": 5188,
      "url": "http://127.0.0.1:5188"
    }
  ]
}
