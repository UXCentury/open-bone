{
  "name": "@openbone/canvaskit",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "description": "OpenBone runtime for CanvasKit (Skia WebAssembly): renderer and player",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=browser --packages=external --sourcemap --outfile=dist/index.js"
  },
  "dependencies": {
    "@openbone/core": "workspace:*",
    "@openbone/engine-kit": "workspace:*",
    "@openbone/runtime": "workspace:*"
  },
  "peerDependencies": {
    "canvaskit-wasm": ">=0.39.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "canvaskit-wasm": "^0.40.0",
    "@openbone/render-webgl": "workspace:*"
  }
}
