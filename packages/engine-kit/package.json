{
  "name": "@openbone/engine-kit",
  "version": "0.3.0",
  "description": "Shared loading, playback and draw batching for the OpenBone game-engine runtimes",
  "keywords": [
    "openbone",
    "skeletal-animation",
    "2d-animation",
    "animation",
    "game-engine"
  ],
  "homepage": "https://github.com/UXCentury/open-bone/tree/main/packages/engine-kit#readme",
  "bugs": {
    "url": "https://github.com/UXCentury/open-bone/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UXCentury/open-bone.git",
    "directory": "packages/engine-kit"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "node ../build.mjs",
    "prepack": "node ../build.mjs"
  },
  "dependencies": {
    "@openbone/core": "workspace:*",
    "@openbone/player": "workspace:*",
    "@openbone/runtime": "workspace:*",
    "@openbone/scripting": "workspace:*"
  },
  "devDependencies": {
    "@openbone/render-webgl": "workspace:*",
    "esbuild": "^0.28.2"
  }
}
