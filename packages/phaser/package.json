{
  "name": "@openbone/phaser",
  "version": "0.3.0",
  "description": "OpenBone runtime for Phaser 3: a scene plugin, a loader file type and a GameObject",
  "keywords": [
    "openbone",
    "skeletal-animation",
    "2d-animation",
    "animation",
    "phaser",
    "phaser3"
  ],
  "homepage": "https://github.com/UXCentury/open-bone/tree/main/packages/phaser#readme",
  "bugs": {
    "url": "https://github.com/UXCentury/open-bone/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UXCentury/open-bone.git",
    "directory": "packages/phaser"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "node ../build.mjs",
    "prepack": "node ../build.mjs"
  },
  "dependencies": {
    "@openbone/core": "workspace:*",
    "@openbone/engine-kit": "workspace:*",
    "@openbone/runtime": "workspace:*",
    "@openbone/render-canvas": "workspace:*",
    "@openbone/scripting": "workspace:*"
  },
  "peerDependencies": {
    "phaser": ">=3.60.0 <4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "phaser": "3.90.0",
    "@openbone/render-webgl": "workspace:*"
  }
}
