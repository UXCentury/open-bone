{
  "name": "@openbone/pixi",
  "version": "0.2.0",
  "description": "OpenBone runtime for PixiJS v8: a Container that plays OpenBone documents",
  "keywords": [
    "openbone",
    "skeletal-animation",
    "2d-animation",
    "animation",
    "pixi",
    "pixijs"
  ],
  "homepage": "https://github.com/UXCentury/open-bone/tree/main/packages/pixi#readme",
  "bugs": {
    "url": "https://github.com/UXCentury/open-bone/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UXCentury/open-bone.git",
    "directory": "packages/pixi"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "node ../build.mjs",
    "prepack": "node ../build.mjs"
  },
  "dependencies": {
    "@openbone/core": "workspace:*",
    "@openbone/engine-kit": "workspace:*",
    "@openbone/runtime": "workspace:*"
  },
  "peerDependencies": {
    "pixi.js": "^8.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "pixi.js": "^8.22.0",
    "@openbone/render-webgl": "workspace:*"
  }
}
