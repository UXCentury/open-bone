{
  "name": "@openbone/three",
  "version": "0.4.0",
  "description": "OpenBone runtime for Three.js: an Object3D with one material per atlas page",
  "keywords": [
    "openbone",
    "skeletal-animation",
    "2d-animation",
    "animation",
    "three",
    "threejs"
  ],
  "homepage": "https://github.com/UXCentury/open-bone/tree/main/packages/three#readme",
  "bugs": {
    "url": "https://github.com/UXCentury/open-bone/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UXCentury/open-bone.git",
    "directory": "packages/three"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "node ../build.mjs",
    "prepack": "node ../build.mjs"
  },
  "dependencies": {
    "@openbone/core": "workspace:*",
    "@openbone/engine-kit": "workspace:*",
    "@openbone/runtime": "workspace:*"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "three": "^0.187.0",
    "@types/three": "^0.187.0",
    "@openbone/render-webgl": "workspace:*"
  }
}
