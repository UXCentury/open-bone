  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UXCentury/open-bone.git",
    "directory": "packages/render-webgl"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
