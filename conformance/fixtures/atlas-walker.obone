  "scripts": [
    {
      "id": "scr_m3j1t1z",
      "name": "ease-speed",
      "code": "// Ease the blend's \"speed\" towards the \"walk\" switch, so idle and walk cross-fade smoothly.\nfunction onUpdate(dt) {\n  const target = ob.input(\"walk\") ? 1 : 0;\n  const v = Number(ob.input(\"speed\")) || 0;\n  ob.setInput(\"speed\", v + (target - v) * Math.min(1, dt * 4));\n}"
    },
    {
      "id": "scr_fpbpz20",
      "name": "scroll",
      "code": "// Parallax scrolling: layers slide at their own speed while \"speed\" is on, wrapping every tile width.\nconst layers = [{\"bone\":\"bg-far\",\"x\":700,\"y\":240,\"w\":2300,\"speed\":12},{\"bone\":\"bg-mid\",\"x\":700,\"y\":147,\"w\":2300,\"speed\":50},{\"bone\":\"bg-ground\",\"x\":700,\"y\":-6,\"w\":2300,\"speed\":144}];\nconst off = layers.map(() => 0);\nlet v = 0;\nfunction onUpdate(dt) {\n  const target = Number(ob.input(\"speed\")) || 0;\n  v += (target - v) * Math.min(1, dt * 5);\n  for (let i = 0; i < layers.length; i++) {\n    const l = layers[i];\n    off[i] = (off[i] - l.speed * v * dt) % l.w;\n    ob.setBone(l.bone, { x: l.x + off[i], y: l.y });\n  }\n}"
    }
  ],
