  "scripts": [
    {
      "id": "scr_4vv3o2b",
      "name": "counter",
      "code": "let n = 0;\nfunction onEvent(e) { if (e.name === 'click') { n++; ob.setInput('count', n); ob.setInput('status', n > 1 ? 'busy' : 'ready'); } }"
    }
