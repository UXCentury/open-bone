<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>OpenBone.MonoGame</RootNamespace>
    <AssemblyName>OpenBone.MonoGame</AssemblyName>
    <Version>0.4.0</Version>
    <IsPackable>true</IsPackable>
    <PackageId>OpenBone.MonoGame</PackageId>
    <Description>MonoGame (DesktopGL) integration for the OpenBone C# runtime: renderer (blend modes, clipping, two-colour tint), player component with pointer input, and a SoundEffect bridge for audio commands.</Description>
    <PackageTags>$(PackageTags);monogame</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- MonoGame: Ms-PL (permissive; no copyleft on code that links it). -->
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.6.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/OpenBone.Runtime/OpenBone.Runtime.csproj" />
    <ProjectReference Include="../../../src/OpenBone.Scripting.Jint/OpenBone.Scripting.Jint.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- HLSL source of the two-colour tint effect (for mgfxc / DirectX builds); the OpenGL effect is built in code. -->
    <None Include="Shaders/OpenBoneTint.fx" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
