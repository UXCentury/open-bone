<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>OpenBone</RootNamespace>
    <AssemblyName>OpenBone.Runtime</AssemblyName>
    <Version>0.2.0</Version>
    <Authors>OpenBone contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>OpenBone runtime for .NET and Unity: skeletons, animations, constraints, particles, text, state machines and audio commands.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
