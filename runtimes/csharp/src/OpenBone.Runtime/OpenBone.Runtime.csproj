<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>OpenBone</RootNamespace>
    <AssemblyName>OpenBone.Runtime</AssemblyName>
    <Version>0.4.1</Version>
    <IsPackable>true</IsPackable>
    <PackageId>OpenBone.Runtime</PackageId>
    <Description>OpenBone runtime for .NET and Unity: load .obone / .obonb files and play skeletons, animations, constraints, particles, text, state machines and audio commands. No dependencies; produces a renderer-agnostic draw list.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
