{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenBone",
  "version": "0.1.0",
  "identifier": "org.openbone.editor",
  "build": {
    "beforeDevCommand": "pnpm --filter @openbone/editor dev",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "pnpm --filter @openbone/editor build",
    "frontendDist": "../../editor/dist"
  },
  "app": {
    "windows": [{ "title": "OpenBone", "width": 1440, "height": 900, "minWidth": 900, "minHeight": 600 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
