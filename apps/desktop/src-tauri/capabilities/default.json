{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Editor window: open/save .obone files, write exports (ZIP, video, images) and copied assets, read images the user picks, watch art folders for changes, show saved files in their folder, open links in the browser",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    { "identifier": "fs:allow-read-text-file", "allow": [{ "path": "$HOME/**" }], "deny": [{ "path": "$HOME/.ssh/**" }, { "path": "$HOME/.gnupg/**" }, { "path": "$HOME/.aws/**" }] },
    { "identifier": "fs:allow-write-text-file", "allow": [{ "path": "$HOME/**" }], "deny": [{ "path": "$HOME/.ssh/**" }, { "path": "$HOME/.gnupg/**" }, { "path": "$HOME/.aws/**" }] },
    { "identifier": "fs:allow-read-file", "allow": [{ "path": "$HOME/**" }], "deny": [{ "path": "$HOME/.ssh/**" }, { "path": "$HOME/.gnupg/**" }, { "path": "$HOME/.aws/**" }] },
    { "identifier": "fs:allow-write-file", "allow": [{ "path": "$HOME/**" }], "deny": [{ "path": "$HOME/.ssh/**" }, { "path": "$HOME/.gnupg/**" }, { "path": "$HOME/.aws/**" }] },
    { "identifier": "fs:allow-mkdir", "allow": [{ "path": "$HOME/**" }], "deny": [{ "path": "$HOME/.ssh/**" }, { "path": "$HOME/.gnupg/**" }, { "path": "$HOME/.aws/**" }] },
    { "identifier": "fs:allow-watch", "allow": [{ "path": "$HOME" }, { "path": "$HOME/**" }] },
    "fs:allow-unwatch"
  ]
}
