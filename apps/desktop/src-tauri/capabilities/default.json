{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Editor window: open/save .obone files, read images the user picks, watch art folders for changes, show saved files in their folder, open links in the browser",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    { "identifier": "fs:allow-read-text-file", "allow": [{ "path": "$HOME/**" }] },
    { "identifier": "fs:allow-write-text-file", "allow": [{ "path": "$HOME/**" }] },
    { "identifier": "fs:allow-read-file", "allow": [{ "path": "$HOME/**" }] },
    { "identifier": "fs:allow-watch", "allow": [{ "path": "$HOME" }, { "path": "$HOME/**" }] },
    "fs:allow-unwatch"
  ]
}
