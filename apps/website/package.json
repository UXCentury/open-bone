    "astro": "^7.4.10",
    "mermaid": "^11.17.2",
    "sharp": "^0.35.5",
    "starlight-llms-txt": "^0.12.0"
  },
  "devDependencies": {
    "playwright-core": "^1.65.0",
    "starlight-links-validator": "^0.27.0",
    "tsx": "^4.19.0"
  }
