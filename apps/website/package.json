{
  "name": "@openbone/website",
  "version": "0.4.1",
  "private": true,
  "license": "MIT",
  "description": "The OpenBone documentation website (Astro Starlight)",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 5195",
