---
/**
 * A live OpenBone example: the real <openbone-player> web component (packages/player, bundled by scripts/sync.ts)
 * running the .obone file in WebGL, with buttons for its state machine inputs. Loads when scrolled into view and
 * pauses off screen. Sound starts muted (browsers need a click first); the speaker button turns it on.
 */
import { getExample, url } from "../lib/examples";

interface Props {
  example: string;
  /** Play this animation instead of the state machine. */
  animation?: string;
  /** Show input controls under the player (default: true). */
  controls?: boolean;
  /** Show the title bar with the example's name and hint (default: true). */
  header?: boolean;
  /** Load immediately instead of when scrolled into view (the landing page's hero). */
  eager?: boolean;
  class?: string;
}

const { example, animation, controls = true, header = true, eager = false, class: cls } = Astro.props;
const ex = getExample(example);
const src = url(`projects/${ex.id}.obone`);
const bg = ex.background ?? "transparent";
---

<figure class:list={["ob-live not-content", cls]} data-src={src} data-eager={eager ? "" : undefined} style={`--ob-aspect: ${ex.width} / ${ex.height}; --ob-bg: ${bg};`}>
  {
    header && (
      <figcaption class="ob-live-head">
        <span class="ob-live-dot" aria-hidden="true" />
        <strong>{ex.title}</strong>
        {ex.hint && <span class="ob-live-hint">{ex.hint}</span>}
        <span class="ob-live-badge">live</span>
      </figcaption>
    )
  }
  <div class="ob-live-stage">
    <openbone-player
      state-machine={animation ? undefined : (ex.stateMachine ?? undefined)}
      animation={animation}
      muted
      fit="contain"
      aria-label={`${ex.title}, a live OpenBone animation`}></openbone-player>
    <div class="ob-live-loading" aria-hidden="true"><span></span></div>
    {
      ex.hasAudio && (
        <button class="ob-live-sound" type="button" aria-pressed="false" aria-label="Turn sound on">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path fill="currentColor" d="M3 9v6h4l5 5V4L7 9H3z" />
            <path class="ob-wave" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12" />
            <path class="ob-x" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M16 9l5 6M21 9l-5 6" />
          </svg>
          <span class="ob-sound-label">Tap for sound</span>
        </button>
      )
    }
  </div>
  {
    controls && ex.inputs.length > 0 && !animation && (
      <div class="ob-live-controls">
        {ex.inputs.map((i) =>
          i.type === "trigger" ? (
            <button type="button" class="ob-ctl" data-fire={i.name}>
              {i.name}
            </button>
          ) : i.type === "bool" ? (
            <button type="button" class="ob-ctl ob-toggle" data-bool={i.name} aria-pressed={i.value ? "true" : "false"}>
              {i.name}
            </button>
          ) : i.type === "number" ? (
            <label class="ob-ctl ob-range">
              <span>{i.name}</span>
              <input type="range" data-number={i.name} min={i.min ?? 0} max={i.max ?? 1} step="0.01" value={Number(i.value ?? 0)} />
              <output>{Number(i.value ?? 0).toFixed(2)}</output>
            </label>
          ) : null,
        )}
      </div>
    )
  }
</figure>

<script>
  import { mountLivePlayers } from "../lib/live-player";
  mountLivePlayers();
  document.addEventListener("astro:page-load", () => mountLivePlayers());
</script>

<style>
  .ob-live {
    margin: 1.5rem 0;
    border-radius: var(--ob-radius);
    border: 1px solid var(--ob-card-border);
    background: var(--ob-card);
    box-shadow: var(--ob-shadow);
    overflow: hidden;
  }
  .ob-live-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.9rem;
    font-size: var(--sl-text-sm);
    border-bottom: 1px solid var(--ob-card-border);
    color: var(--sl-color-gray-2);
    flex-wrap: wrap;
  }
  .ob-live-head strong {
    color: var(--sl-color-white);
  }
  .ob-live-hint {
    color: var(--sl-color-gray-3);
    order: 3;
    flex-basis: 100%;
    font-size: var(--sl-text-xs);
    margin-top: -0.3rem;
    padding-left: 1.15rem;
  }
  .ob-live-badge {
    margin-inline-start: auto;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    color: #0b0614;
    background: var(--ob-amber);
    font-weight: 700;
  }
  .ob-live-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: #3ddc84;
    box-shadow: 0 0 0 3px rgb(61 220 132 / 0.2);
  }
  .ob-live-stage {
    position: relative;
    aspect-ratio: var(--ob-aspect);
    max-height: 72vh;
    margin-inline: auto;
    background: var(--ob-bg);
  }
  .ob-live-stage openbone-player {
    display: block;
    width: 100%;
    height: 100%;
  }
  .ob-live-loading {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
    transition: opacity 0.4s;
  }
  .ob-live-loading span {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 3px solid rgb(255 255 255 / 0.35);
    border-top-color: #fff;
    animation: ob-spin 0.9s linear infinite;
  }
  .ob-live[data-ready] .ob-live-loading {
    opacity: 0;
  }
  @keyframes ob-spin {
    to {
      transform: rotate(360deg);
    }
  }
  /* Muted: a labelled pill ("Tap for sound"); playing: just the speaker. */
  .ob-live-sound {
    position: absolute;
    right: 0.5rem;
    top: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 2rem;
    padding: 0 0.75rem 0 0.55rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.3);
    background: rgb(20 10 30 / 0.7);
    color: #fff;
    font: inherit;
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    backdrop-filter: blur(6px);
    transition:
      background 0.15s,
      transform 0.15s;
  }
  .ob-live-sound:hover {
    background: rgb(20 10 30 / 0.9);
    transform: translateY(-1px);
  }
  .ob-live-sound[aria-pressed="true"] {
    width: 2rem;
    padding: 0;
    justify-content: center;
    opacity: 0.8;
  }
  .ob-live-sound[aria-pressed="true"] .ob-sound-label {
    display: none;
  }
  .ob-live-sound .ob-wave {
    display: none;
  }
  .ob-live-sound[aria-pressed="true"] .ob-wave {
    display: inline;
  }
  .ob-live-sound[aria-pressed="true"] .ob-x {
    display: none;
  }
  .ob-live-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.7rem 0.9rem;
    border-top: 1px solid var(--ob-card-border);
  }
  .ob-ctl {
    font: inherit;
    font-size: var(--sl-text-sm);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  button.ob-ctl:hover {
    border-color: var(--sl-color-accent);
  }
  button.ob-ctl:active {
    transform: translateY(1px);
  }
  button[data-fire]::before {
    content: "⚡";
    font-size: 0.8em;
  }
  .ob-toggle::before {
    content: "";
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    border: 2px solid var(--sl-color-gray-3);
  }
  .ob-toggle[aria-pressed="true"] {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
  }
  .ob-toggle[aria-pressed="true"]::before {
    background: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
  }
  .ob-range {
    cursor: default;
  }
  .ob-range input {
    width: 8rem;
    accent-color: var(--sl-color-accent);
  }
  .ob-range output {
    font-family: var(--sl-font-mono);
    font-size: 0.85em;
    min-width: 3ch;
  }
</style>
