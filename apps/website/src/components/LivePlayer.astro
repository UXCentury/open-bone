---
/**
 * A live OpenBone example: the real <openbone-player> web component (packages/player, bundled by scripts/sync.ts)
 * running the .obone file in WebGL, with buttons for its state machine inputs.
 *
 * Until someone presses play it is only a poster image (the first frame, rendered at build time): no player script,
 * no document, art or sound is loaded. The play click loads it and starts it with sound (that click unlocks audio).
 * A fullscreen button shows the player and its controls full screen. Started players pause off screen.
 */
import { getExample, url, versionedUrl } from "../lib/examples";

interface Props {
  example: string;
  /** Play this animation instead of the state machine. */
  animation?: string;
  /** Show input controls under the player (default: true). */
  controls?: boolean;
  /** Show the title bar with the example's name and hint (default: true). */
  header?: boolean;
  /** Above the fold (the landing page's hero): load the poster eagerly. */
  eager?: boolean;
  class?: string;
}

const { example, animation, controls = true, header = true, eager = false, class: cls } = Astro.props;
const ex = getExample(example);
const src = versionedUrl(`projects/${ex.id}.obone`);
const player = versionedUrl("player/openbone-player.js");
const poster = url(`posters/${ex.id}.webp`);
const bg = ex.background ?? "transparent";
---

<figure
  class:list={["ob-live not-content", cls]}
  data-src={src}
  data-player={player}
  data-audio={ex.hasAudio ? "" : undefined}
  style={`--ob-aspect: ${ex.width} / ${ex.height}; --ob-bg: ${bg};`}
>
  {
    header && (
      <figcaption class="ob-live-head">
        <span class="ob-live-dot" aria-hidden="true" />
        <strong>{ex.title}</strong>
        {ex.hint && <span class="ob-live-hint">{ex.hint}</span>}
        <span class="ob-live-badge">live</span>
      </figcaption>
    )
  }
  <div class="ob-live-stage">
    <img
      class="ob-live-poster"
      src={poster}
      alt={`${ex.title}: the first frame. Press play to run it live.`}
      width={ex.width}
      height={ex.height}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : "auto"}
      decoding="async"
    />
    <openbone-player
      state-machine={animation ? undefined : (ex.stateMachine ?? undefined)}
      animation={animation}
      fit="contain"
      aria-label={`${ex.title}, a live OpenBone animation`}></openbone-player>
    <div class="ob-live-loading" aria-hidden="true"><span></span></div>
    <button class="ob-live-play" type="button" aria-label={`Play ${ex.title}${ex.hasAudio ? " with sound" : ""}`}>
      <span class="ob-play-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="30" height="30"><path fill="currentColor" d="M8 5.5v13a1 1 0 0 0 1.5.86l10.6-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z"></path></svg>
      </span>
      <span class="ob-play-label">{ex.hasAudio ? "Play with sound" : "Play"}</span>
    </button>
    <div class="ob-live-tools">
      {
        ex.hasAudio && (
          <button class="ob-live-tool ob-live-sound" type="button" aria-pressed="true" aria-label="Mute" title="Mute">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path fill="currentColor" d="M3 9v6h4l5 5V4L7 9H3z" />
              <path class="ob-wave" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12" />
              <path class="ob-x" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M16 9l5 6M21 9l-5 6" />
            </svg>
          </button>
        )
      }
      <button class="ob-live-tool ob-live-fs" type="button" aria-pressed="false" aria-label="Full screen" title="Full screen" hidden>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path class="ob-fs-open" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" />
          <path class="ob-fs-close" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5" />
        </svg>
      </button>
    </div>
  </div>
  {
    controls && ex.inputs.length > 0 && !animation && (
      <div class="ob-live-controls">
        {ex.inputs.map((i) =>
          i.type === "trigger" ? (
            <button type="button" class="ob-ctl" data-fire={i.name}>
              {i.name}
            </button>
          ) : i.type === "bool" ? (
            <button type="button" class="ob-ctl ob-toggle" data-bool={i.name} aria-pressed={i.value ? "true" : "false"}>
              {i.name}
            </button>
          ) : i.type === "number" ? (
            <label class="ob-ctl ob-range">
              <span>{i.name}</span>
              <input type="range" data-number={i.name} min={i.min ?? 0} max={i.max ?? 1} step="0.01" value={Number(i.value ?? 0)} />
              <output>{Number(i.value ?? 0).toFixed(2)}</output>
            </label>
          ) : null,
        )}
      </div>
    )
  }
</figure>

<script>
  import { mountLivePlayers } from "../lib/live-player";
  mountLivePlayers();
  document.addEventListener("astro:page-load", () => mountLivePlayers());
</script>

<style>
  .ob-live {
    margin: 1.5rem 0;
    border-radius: var(--ob-radius);
    border: 1px solid var(--ob-card-border);
    background: var(--ob-card);
    box-shadow: var(--ob-shadow);
    overflow: hidden;
  }
  .ob-live-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.9rem;
    font-size: var(--sl-text-sm);
    border-bottom: 1px solid var(--ob-card-border);
    color: var(--sl-color-gray-2);
    flex-wrap: wrap;
  }
  .ob-live-head strong {
    color: var(--sl-color-white);
  }
  .ob-live-hint {
    color: var(--sl-color-gray-3);
    order: 3;
    flex-basis: 100%;
    font-size: var(--sl-text-xs);
    margin-top: -0.3rem;
    padding-left: 1.15rem;
  }
  .ob-live-badge {
    margin-inline-start: auto;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    color: #0b0614;
    background: var(--ob-amber);
    font-weight: 700;
  }
  .ob-live-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: #3ddc84;
    box-shadow: 0 0 0 3px rgb(61 220 132 / 0.2);
  }
  .ob-live-stage {
    position: relative;
    aspect-ratio: var(--ob-aspect);
    max-height: 72vh;
    margin-inline: auto;
    background: var(--ob-bg);
  }
  .ob-live-stage openbone-player,
  .ob-live-poster {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
  .ob-live-poster {
    object-fit: contain;
    transition: opacity 0.3s;
  }
  /* The player stays invisible until its first frame is drawn, then replaces the poster. */
  .ob-live-stage openbone-player {
    opacity: 0;
  }
  .ob-live[data-ready] openbone-player {
    opacity: 1;
  }
  .ob-live[data-ready] .ob-live-poster {
    opacity: 0;
  }
  .ob-live-loading {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
    transition: opacity 0.4s;
  }
  .ob-live-loading span {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 3px solid rgb(255 255 255 / 0.35);
    border-top-color: #fff;
    animation: ob-spin 0.9s linear infinite;
  }
  .ob-live-loading {
    opacity: 0;
  }
  .ob-live[data-playing]:not([data-ready]) .ob-live-loading {
    opacity: 1;
  }
  @keyframes ob-spin {
    to {
      transform: rotate(360deg);
    }
  }
  /* Before it runs: the first frame, dimmed, with a big play button (that click also turns the sound on). */
  .ob-live-play {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    width: 100%;
    border: 0;
    padding: 0;
    background: radial-gradient(closest-side, rgb(10 4 16 / 0.35), rgb(10 4 16 / 0.15));
    color: #fff;
    font: inherit;
    cursor: pointer;
    transition: opacity 0.25s;
  }
  .ob-play-icon {
    display: grid;
    place-items: center;
    width: clamp(3.5rem, 12%, 5rem);
    aspect-ratio: 1;
    border-radius: 50%;
    padding-left: 0.2rem;
    color: #0b0614;
    background: linear-gradient(135deg, #8fd6ff, #4b8ff0);
    box-shadow:
      0 0 0 6px rgb(255 255 255 / 0.18),
      0 12px 36px -8px rgb(0 0 0 / 0.6);
    transition: transform 0.15s;
  }
  .ob-play-label {
    font-size: var(--sl-text-sm);
    font-weight: 700;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: rgb(20 10 30 / 0.7);
    backdrop-filter: blur(6px);
  }
  .ob-live-play:hover .ob-play-icon,
  .ob-live-play:focus-visible .ob-play-icon {
    transform: scale(1.08);
  }
  .ob-live[data-playing] .ob-live-play {
    opacity: 0;
    pointer-events: none;
  }
  /* Top-right tools: mute (while it runs) and full screen. */
  .ob-live-tools {
    position: absolute;
    right: 0.5rem;
    top: 0.5rem;
    display: flex;
    gap: 0.4rem;
    z-index: 2;
  }
  .ob-live-tool {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    padding: 0;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.3);
    background: rgb(20 10 30 / 0.7);
    color: #fff;
    opacity: 0.85;
    cursor: pointer;
    backdrop-filter: blur(6px);
    transition:
      opacity 0.15s,
      transform 0.15s;
  }
  .ob-live-tool:hover {
    opacity: 1;
    transform: translateY(-1px);
  }
  .ob-live-tool[hidden] {
    display: none;
  }
  .ob-live:not([data-playing]) .ob-live-sound {
    display: none;
  }
  .ob-live-fs .ob-fs-close,
  .ob-live-fs[aria-pressed="true"] .ob-fs-open {
    display: none;
  }
  .ob-live-fs[aria-pressed="true"] .ob-fs-close {
    display: inline;
  }
  /* Full screen: the player fills the screen above its controls. */
  .ob-live:fullscreen {
    display: flex;
    flex-direction: column;
    margin: 0;
    border: 0;
    border-radius: 0;
    background: #0b0614;
  }
  .ob-live:fullscreen .ob-live-stage {
    flex: 1;
    aspect-ratio: auto;
    max-height: none;
    width: 100%;
  }
  .ob-live:fullscreen .ob-live-controls {
    justify-content: center;
    border-color: rgb(255 255 255 / 0.1);
  }
  /* Always dark around the art in full screen, whatever the site theme. */
  .ob-live:fullscreen .ob-live-head {
    color: #c7c0d4;
    border-color: rgb(255 255 255 / 0.1);
  }
  .ob-live:fullscreen .ob-live-head strong {
    color: #fff;
  }
  .ob-live:fullscreen .ob-live-hint {
    color: #9a90ab;
  }
  .ob-live-sound .ob-wave {
    display: none;
  }
  .ob-live-sound[aria-pressed="true"] .ob-wave {
    display: inline;
  }
  .ob-live-sound[aria-pressed="true"] .ob-x {
    display: none;
  }
  .ob-live-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.7rem 0.9rem;
    border-top: 1px solid var(--ob-card-border);
  }
  .ob-ctl {
    font: inherit;
    font-size: var(--sl-text-sm);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  button.ob-ctl:hover {
    border-color: var(--sl-color-accent);
  }
  button.ob-ctl:active {
    transform: translateY(1px);
  }
  button[data-fire]::before {
    content: "⚡";
    font-size: 0.8em;
  }
  .ob-toggle::before {
    content: "";
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    border: 2px solid var(--sl-color-gray-3);
  }
  .ob-toggle[aria-pressed="true"] {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
  }
  .ob-toggle[aria-pressed="true"]::before {
    background: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
  }
  .ob-range {
    cursor: default;
  }
  .ob-range input {
    width: 8rem;
    accent-color: var(--sl-color-accent);
  }
  .ob-range output {
    font-family: var(--sl-font-mono);
    font-size: 0.85em;
    min-width: 3ch;
  }
</style>
