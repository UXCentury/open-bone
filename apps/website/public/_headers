# Response headers for the Cloudflare static-assets Worker (https://developers.cloudflare.com/workers/static-assets/headers/).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Fingerprinted build output: cache for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/pagefind/*
  Cache-Control: public, max-age=3600

# Example projects, their art and the web player. The pages load the player and the projects with ?v=<content hash>
# (versionedUrl in src/lib/examples.ts), so a deploy reaches visitors at once despite these caches.
/projects/*
  Cache-Control: public, max-age=86400

/player/*
  Cache-Control: public, max-age=86400

/og/*
  Cache-Control: public, max-age=86400
